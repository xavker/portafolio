        // Seleccionar Estación y Actualizar el Inspector SCADA
        function pipelineSelectStation(stId) {
            soteData.activeStation = stId;
            const st = soteData.stations[stId];
            if (!st) return;

            // Actualizar botones de estación en la barra rápida
            document.querySelectorAll('.st-btn').forEach((b, idx) => {
                if (idx + 1 === stId) {
                    b.classList.add('bg-cyan-500', 'text-slate-950', 'font-bold');
                    b.classList.remove('bg-slate-900', 'text-slate-300');
                } else {
                    b.classList.remove('bg-cyan-500', 'text-slate-950', 'font-bold');
                    b.classList.add('bg-slate-900', 'text-slate-300');
                }
            });

            // Resaltar en SVG
            for (let i = 1; i <= 11; i++) {
                const node = document.getElementById(`station-node-${i}`);
                if (node) {
                    const rect = node.querySelector('rect');
                    if (rect) {
                        rect.setAttribute('stroke-width', i === stId ? '3' : (i === 5 || i === 11 ? '2' : '1.5'));
                    }
                }
            }

            document.getElementById('detail-title').innerText = st.name;
            document.getElementById('detail-coords').innerText = st.coords;
            document.getElementById('detail-badge').innerText = st.badge;
            document.getElementById('detail-unit-title').innerText = st.unitTitle;
            document.getElementById('detail-unit-badge').innerText = st.unitBadge;
            document.getElementById('detail-pid-tag').innerText = st.pidTag;
            document.getElementById('detail-pid-sp').innerText = st.pidSP;
            document.getElementById('detail-ot-number').innerText = st.ot;
            document.getElementById('detail-plan').innerText = st.plan;

            const baseDis = soteData.esdActive ? 40 : (soteData.surgeActive && (stId === 5 || stId === 6) ? st.baseDis + 320 : st.baseDis);
            document.getElementById('detail-pid-pv').innerText = `${baseDis.toFixed(1)} PSI`;
            document.getElementById('detail-pid-out').innerText = soteData.esdActive ? '0.0% (Desconectado)' : st.pidOut;
            document.getElementById('detail-vibration').innerText = soteData.esdActive ? '0.00 mm/s (Detenido)' : st.vibration;
            document.getElementById('detail-winding-temp').innerText = st.temp;
            document.getElementById('detail-pump-a-status').innerText = soteData.esdActive ? 'PARADA ESD' : st.statusA;
            document.getElementById('detail-pump-a-status').className = soteData.esdActive ? 'text-red-400 font-bold' : 'text-emerald-400 font-bold';
            document.getElementById('detail-pump-b-status').innerText = soteData.esdActive ? 'DESCONECTADO' : st.statusB;
        }

        // Conmutar Pausa y Marcha de Flujo
        function pipelineToggleFlow() {
            if (soteData.esdActive) {
                soteData.esdActive = false;
                soteData.flowing = true;
                document.getElementById('scada-status-pill').innerText = "SCADA SOTE EN LÍNEA // OPERACIÓN 350K BPD";
                document.getElementById('scada-status-pill').parentElement.className = "inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-900/90 border border-cyan-500/40 text-xs font-mono text-emerald-400 shadow-[0_0_15px_rgba(16,185,129,0.25)]";
                pipelineShowAlert("REINICIO SOTE // BOMBAS RESTABLECIDAS A CONSIGNAS SCADA", "cyan");
            } else {
                soteData.flowing = !soteData.flowing;
            }

            const btnText = document.getElementById('btn-flow-text');
            const btnIcon = document.getElementById('btn-flow-icon');
            const svg = document.getElementById('pipeline-svg');

            if (soteData.flowing) {
                btnText.innerText = "Pausar Flujo";
                btnIcon.className = "fa-solid fa-pause";
                if (svg) svg.classList.remove('pipeline-flow-paused');
                document.getElementById('scada-status-pill').innerText = "SCADA SOTE EN LÍNEA // OPERACIÓN 350K BPD";
                document.querySelectorAll('.pump-impeller').forEach(el => el.parentElement.classList.add('pump-running'));
            } else {
                btnText.innerText = "Reanudar Flujo";
                btnIcon.className = "fa-solid fa-play";
                if (svg) svg.classList.add('pipeline-flow-paused');
                document.getElementById('scada-status-pill').innerText = "SISTEMA PAUSADO // LAZOS EN ESPERA";
                document.querySelectorAll('.pump-impeller').forEach(el => el.parentElement.classList.remove('pump-running'));
            }
            pipelineSelectStation(soteData.activeStation);
        }

        // Modificar Caudal Diario (BPD)
        function pipelineUpdateFlowRate(val) {
            soteData.flowRate = parseInt(val) * 1000;
            document.getElementById('telemetry-flow').innerText = (soteData.flowRate).toLocaleString();
            document.getElementById('slider-val-readout').innerText = `${val}k BPD`;

            const stream = document.getElementById('pipeline-flow-stream');
            if (stream) {
                const duration = (2.4 - ((val - 200) / 200) * 1.6).toFixed(2);
                stream.style.animationDuration = `${duration}s`;
            }
        }

        // Lanzamiento de Herramienta PIG Inteligente a lo largo de los 503 KM
        function pipelineLaunchPIG() {
            if (soteData.pigActive) {
                pipelineShowAlert("HERRAMIENTA PIG YA ESTÁ EN TRÁNSITO INTERNO POR EL SOTE", "amber");
                return;
            }
            if (!soteData.flowing) {
                pipelineShowAlert("ATENCIÓN: EL OLEODUCTO DEBE ESTAR EN FLUJO PARA LANZAR PIG", "red");
                return;
            }

            soteData.pigActive = true;
            soteData.pigProgress = 0.0;
            
            const pigGroup = document.getElementById('pig-tool-group');
            const path = document.getElementById('pipeline-fluid-channel');
            if (!pigGroup || !path) return;

            pigGroup.classList.remove('hidden');
            document.getElementById('pig-status-pill').innerText = "EN TRÁNSITO MFL";
            document.getElementById('pig-status-pill').className = "text-xs sm:text-sm font-bold text-purple-400 mt-1";
            pipelineShowAlert("PIG LANZADO EN LAGO AGRIO (KM 0) // ESCANEO ULTRASÓNICO DE PARED ACTIVO", "purple");

            const pathLength = path.getTotalLength();
            const transitDuration = 20000; // 20s transit
            const startTime = performance.now();

            function stepPIG(now) {
                if (!soteData.pigActive) return;

                const elapsed = now - startTime;
                soteData.pigProgress = Math.min(elapsed / transitDuration, 1.0);
                
                const currentDist = soteData.pigProgress * pathLength;
                const pt = path.getPointAtLength(currentDist);

                pigGroup.setAttribute('transform', `translate(${pt.x}, ${pt.y})`);

                const currentKM = (soteData.pigProgress * 503.0).toFixed(1);
                document.getElementById('pig-km-pill').innerText = `KM ${currentKM} / 503.0`;

                // Avisos al pasar por puntos clave del SOTE
                if (soteData.pigProgress > 0.12 && soteData.pigProgress < 0.14) {
                    pipelineShowAlert("PIG PASANDO EB-02 LUMBAQUI (KM 65) // ESPESOR 12.7 mm [OK]", "cyan");
                } else if (soteData.pigProgress > 0.25 && soteData.pigProgress < 0.27) {
                    pipelineShowAlert("PIG EN EB-03 EL SALADO (KM 130) // PRESIÓN Y REGISTRO MAGNÉTICO OK", "cyan");
                } else if (soteData.pigProgress > 0.35 && soteData.pigProgress < 0.37) {
                    pipelineShowAlert("PIG EN EB-04 BAEZA (KM 180) // VELOCIDAD 2.8 m/s", "cyan");
                } else if (soteData.pigProgress > 0.43 && soteData.pigProgress < 0.45) {
                    pipelineShowAlert("PIG EN EB-05 PAPALLACTA (KM 220) // INICIANDO ASCENSO A GUAMANÍ", "amber");
                } else if (soteData.pigProgress > 0.46 && soteData.pigProgress < 0.48) {
                    pipelineShowAlert("PIG CRUZANDO CUMBRE DE GUAMANÍ (4,064 msnm) // INTEGRIDAD 100%", "amber");
                } else if (soteData.pigProgress > 0.52 && soteData.pigProgress < 0.54) {
                    pipelineShowAlert("PIG EN ER-01 SAN JUAN // ENTRANDO A TRAMO REDUCTOR", "cyan");
                } else if (soteData.pigProgress > 0.61 && soteData.pigProgress < 0.63) {
                    pipelineShowAlert("PIG PASANDO ER-02 CHIRIBOGA (KM 310)", "cyan");
                } else if (soteData.pigProgress > 0.69 && soteData.pigProgress < 0.71) {
                    pipelineShowAlert("PIG PASANDO ER-03 LA PALMA (KM 350)", "cyan");
                } else if (soteData.pigProgress > 0.78 && soteData.pigProgress < 0.80) {
                    pipelineShowAlert("PIG PASANDO ER-04 SANTO DOMINGO (KM 395)", "cyan");
                } else if (soteData.pigProgress > 0.88 && soteData.pigProgress < 0.90) {
                    pipelineShowAlert("PIG PASANDO EB-06 QUININDÉ (KM 445) // TRAMO FINAL A BALAO", "cyan");
                }

                if (soteData.pigProgress < 1.0 && soteData.flowing) {
                    requestAnimationFrame(stepPIG);
                } else if (soteData.pigProgress >= 1.0) {
                    pigGroup.classList.add('hidden');
                    soteData.pigActive = false;
                    document.getElementById('pig-status-pill').innerText = "RECIBIDO EN BALAO";
                    document.getElementById('pig-status-pill').className = "text-xs sm:text-sm font-bold text-emerald-400 mt-1";
                    pipelineShowAlert("¡PIG RECIBIDO EN TRAMPA DE BALAO (KM 503)! // INSPECCIÓN MFL COMPLETADA // 0 ANOMALÍAS", "emerald");
                }
            }

            requestAnimationFrame(stepPIG);
        }

        // Simulación de Golpe de Ariete (Surge Event en tramo reductor)
        function pipelineSimulateSurge() {
            if (soteData.surgeActive || soteData.esdActive) return;

            soteData.surgeActive = true;
            const stream = document.getElementById('pipeline-flow-stream');
            if (stream) stream.classList.add('pipeline-surge-active');

            pipelineShowAlert("¡GOLPE DE ARIETE EN ER-01 SAN JUAN! VÁLVULA DE ALIVIO SURGE ACTUANDO", "red");
            document.getElementById('scada-status-pill').innerText = "TRANSITORIO HIDRÁULICO SOTE // ALIVIO SURGE ACTIVADO";
            document.getElementById('scada-status-pill').parentElement.className = "inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-red-950/80 border border-red-500/50 text-xs font-mono text-red-400 animate-pulse";

            document.getElementById('telemetry-max-pres').innerText = "1,680";

            setTimeout(() => {
                if (!soteData.esdActive) {
                    if (stream) stream.classList.remove('pipeline-surge-active');
                    soteData.surgeActive = false;
                    document.getElementById('scada-status-pill').innerText = "SCADA SOTE EN LÍNEA // OPERACIÓN 350K BPD";
                    document.getElementById('scada-status-pill').parentElement.className = "inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-900/90 border border-cyan-500/40 text-xs font-mono text-emerald-400 shadow-[0_0_15px_rgba(16,185,129,0.25)]";
                    pipelineShowAlert("DCS DeltaV SOTE: VÁLVULAS DE ALIVIO AMORTIGUARON ONDA // PRESIÓN NORMALIZADA", "emerald");
                    pipelineSelectStation(soteData.activeStation);
                }
            }, 4000);
        }

        // Parada de Emergencia ESD del SOTE
        function pipelineEmergencyStop() {
            soteData.esdActive = true;
            soteData.flowing = false;
            soteData.surgeActive = false;
            
            const svg = document.getElementById('pipeline-svg');
            if (svg) svg.classList.add('pipeline-flow-paused');
            document.querySelectorAll('.pump-impeller').forEach(el => el.parentElement.classList.remove('pump-running'));

            document.getElementById('btn-flow-text').innerText = "Restablecer SOTE";
            document.getElementById('btn-flow-icon').className = "fa-solid fa-rotate-left";

            document.getElementById('scada-status-pill').innerText = "PARADA ESD SOTE // LÍNEA AISLADA";
            document.getElementById('scada-status-pill').parentElement.className = "inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-red-950/90 border border-red-500 text-xs font-mono text-red-400 font-bold";

            pipelineShowAlert("PARADA DE EMERGENCIA ESD EN TODO EL SOTE // BOMBAS DESCONECTADAS // SDV CERRADAS", "red");
            
            document.getElementById('telemetry-max-pres').innerText = "90";
            document.getElementById('telemetry-flow').innerText = "0";

            pipelineSelectStation(soteData.activeStation);
        }

        // Notificaciones Flotantes
        function pipelineShowAlert(msg, color) {
            const box = document.getElementById('pipeline-alert-box');
            const txt = document.getElementById('pipeline-alert-msg');
            if (!box || !txt) return;

            txt.innerText = msg;
            let colorClasses = "bg-cyan-950/90 border-cyan-500/60 text-cyan-300";
            if (color === "amber") colorClasses = "bg-amber-950/90 border-amber-500/60 text-amber-300";
            if (color === "purple") colorClasses = "bg-purple-950/90 border-purple-500/60 text-purple-300";
            if (color === "red") colorClasses = "bg-red-950/90 border-red-500/60 text-red-300 font-bold";
            if (color === "emerald") colorClasses = "bg-emerald-950/90 border-emerald-500/60 text-emerald-300 font-bold";

            box.className = `absolute top-4 left-1/2 -translate-x-1/2 z-30 px-4 py-2 rounded-lg text-xs font-mono border backdrop-blur-md shadow-2xl transition-all duration-300 ${colorClasses}`;
            box.classList.remove('hidden');

            clearTimeout(window.pipelineAlertTimeout);
            window.pipelineAlertTimeout = setTimeout(() => {
                box.classList.add('hidden');
            }, 4500);
        }

        // Bucle de Micro-Fluctuaciones de Telemetría Realista SOTE
        setInterval(() => {
            if (!soteData.flowing || soteData.esdActive) return;

            const jitter = () => (Math.random() * 2.6 - 1.3);
            const activeSt = soteData.stations[soteData.activeStation];
            if (activeSt && !soteData.surgeActive) {
                const pvEl = document.getElementById('detail-pid-pv');
                if (pvEl) {
                    const base = activeSt.baseDis;
                    pvEl.innerText = `${(base + jitter()).toFixed(1)} PSI`;
                }
            }
        }, 1200);

        // Inicializar bombas en movimiento y estación 1 por defecto
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.pump-impeller').forEach(el => el.parentElement.classList.add('pump-running'));
            pipelineSelectStation(1);
        });
        // Si el DOM ya cargó:
        if (document.readyState === 'complete' || document.readyState === 'interactive') {
            document.querySelectorAll('.pump-impeller').forEach(el => el.parentElement.classList.add('pump-running'));
            pipelineSelectStation(1);
        }

    </script>
</body>
</html>
