<!DOCTYPE html>
<html lang="es" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simulador SCADA SOTE (503 km // 350,000 BPD) | Ing. Leonardo Ramón</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@300;400;500;700&family=Orbitron:wght@400;600;800;900&family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        cyber: {
                            bg: '#070b14',
                            card: '#0d1527',
                            border: '#1e293b',
                            neon: '#00f2fe',
                            electric: '#4facfe',
                            emerald: '#10b981',
                            purple: '#8b5cf6',
                            accent: '#38bdf8'
                        }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                        display: ['Orbitron', 'sans-serif']
                    }
                }
            }
        }
    </script>
    <style>
        .neon-glow { text-shadow: 0 0 10px rgba(0, 242, 254, 0.6), 0 0 20px rgba(0, 242, 254, 0.3); }
        .neon-box-glow { box-shadow: 0 0 25px -5px rgba(0, 242, 254, 0.25), inset 0 0 15px -5px rgba(0, 242, 254, 0.15); }
        .cyber-grid {
            background-size: 40px 40px;
            background-image: 
                linear-gradient(to right, rgba(0, 242, 254, 0.04) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(0, 242, 254, 0.04) 1px, transparent 1px);
        }
        .cyber-glass {
            background: rgba(13, 21, 39, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border: 1px solid rgba(0, 242, 254, 0.2);
        }
        @keyframes spinImpeller {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
        .pump-running .pump-impeller {
            animation: spinImpeller 0.8s linear infinite;
        }
        .pump-stopped .pump-impeller {
            animation: none !important;
        }
        @keyframes pipelineFlowAnim {
            0% { stroke-dashoffset: 0; }
            100% { stroke-dashoffset: -56; }
        }
        .pipeline-animated-flow {
            animation: pipelineFlowAnim 1.2s linear infinite;
        }
        .pipeline-flow-paused .pipeline-animated-flow {
            animation-play-state: paused !important;
        }
        @keyframes surgePulse {
            0%, 100% { stroke: #ef4444; stroke-width: 8; opacity: 1; }
            50% { stroke: #f59e0b; stroke-width: 12; opacity: 0.7; }
        }
        .pipeline-surge-active {
            animation: surgePulse 0.5s ease-in-out infinite !important;
        }
        ::-webkit-scrollbar { width: 8px; height: 6px; }
        ::-webkit-scrollbar-track { background: #070b14; }
        ::-webkit-scrollbar-thumb { background: #1e293b; border-radius: 4px; border: 1px solid rgba(0, 242, 254, 0.2); }
        ::-webkit-scrollbar-thumb:hover { background: #00f2fe; }
    </style>
</head>
<body class="bg-cyber-bg text-slate-200 font-sans min-h-screen cyber-grid p-3 sm:p-6">
    <div class="max-w-7xl mx-auto space-y-6">
        <div class="flex items-center justify-between pb-4 border-b border-cyan-500/20">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-lg bg-slate-900 border border-cyan-400 flex items-center justify-center font-display font-black text-cyan-400 shadow-[0_0_15px_rgba(0,242,254,0.3)]">
                    LXR
                </div>
                <div>
                    <h1 class="font-display font-bold text-white text-base sm:text-lg tracking-wide">
                        CONSOLA SCADA &bull; SISTEMA DE OLEODUCTO TRANSECUATORIANO (SOTE)
                    </h1>
                    <p class="text-xs font-mono text-cyan-400">
                        ING. LEONARDO XAVIER RAMÓN POMA // EP PETROECUADOR // 503 KM // 350.000 BPD
                    </p>
                </div>
            </div>
            <a href="index.html" class="px-3.5 py-1.5 rounded-lg bg-slate-900 border border-cyan-500/40 text-xs font-mono text-cyan-300 hover:text-white transition-all flex items-center gap-2">
                <i class="fa-solid fa-arrow-left"></i> Volver al Portafolio
            </a>
        </div>

        <!-- ========================================================================= -->
        <!-- 03. SCADA SOTE: SISTEMA DE OLEODUCTO TRANSECUATORIANO (503 KM // 350K BPD) -->
        <!-- ========================================================================= -->
        <section id="oleoducto" class="space-y-8 scroll-mt-24">
            <!-- Header de la Sección -->
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div class="space-y-1">
                    <div class="flex items-center gap-3">
                        <span class="text-cyan-400 font-mono text-lg font-bold">03.</span>
                        <h2 class="text-2xl sm:text-3xl font-display font-bold text-white tracking-wide">
                            SISTEMA DE OLEODUCTO TRANSECUATORIANO (SOTE)
                        </h2>
                    </div>
                    <p class="text-xs sm:text-sm font-mono text-cyan-400/90 pl-8">
                        503 KM DE EXTENSIÓN &bull; 350.000 BPD &bull; 6 ESTACIONES DE BOMBEO, 4 REDUCTORAS Y TERMINAL BALAO
                    </p>
                </div>
                <div class="flex items-center gap-2 self-start md:self-auto">
                    <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-slate-900/90 border border-cyan-500/40 text-xs font-mono text-emerald-400 shadow-[0_0_15px_rgba(16,185,129,0.25)]">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                        <span id="scada-status-pill" class="font-bold">SCADA SOTE EN LÍNEA // OPERACIÓN 350K BPD</span>
                    </span>
                </div>
            </div>

            <!-- Panel Principal SCADA Dashboard -->
            <div class="cyber-glass rounded-2xl p-4 sm:p-6 border border-cyan-500/30 neon-box-glow space-y-6">
                
                <!-- Barra Superior de Parámetros Globales SOTE -->
                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3 text-xs font-mono">
                    <div class="p-3 rounded-xl bg-slate-950/80 border border-slate-800 flex flex-col justify-between">
                        <span class="text-slate-400 text-[10px] uppercase flex items-center gap-1.5">
                            <i class="fa-solid fa-gauge-high text-cyan-400"></i> Caudal Diario
                        </span>
                        <div class="text-base sm:text-lg font-bold text-white mt-1">
                            <span id="telemetry-flow">350,000</span> <span class="text-[10px] text-cyan-400 font-normal">BPD</span>
                        </div>
                        <span class="text-[10px] text-emerald-400">2,318 m³/h (Continuo)</span>
                    </div>

                    <div class="p-3 rounded-xl bg-slate-950/80 border border-slate-800 flex flex-col justify-between">
                        <span class="text-slate-400 text-[10px] uppercase flex items-center gap-1.5">
                            <i class="fa-solid fa-route text-cyan-400"></i> Distancia Total
                        </span>
                        <div class="text-base sm:text-lg font-bold text-white mt-1">
                            503.0 <span class="text-[10px] text-cyan-400 font-normal">KM</span>
                        </div>
                        <span class="text-[10px] text-slate-400">Lago Agrio a Balao</span>
                    </div>

                    <div class="p-3 rounded-xl bg-slate-950/80 border border-slate-800 flex flex-col justify-between">
                        <span class="text-slate-400 text-[10px] uppercase flex items-center gap-1.5">
                            <i class="fa-solid fa-mountain text-amber-400"></i> Cumbre Guamaní
                        </span>
                        <div class="text-base sm:text-lg font-bold text-amber-400 mt-1">
                            4,064 <span class="text-[10px] font-normal">msnm</span>
                        </div>
                        <span class="text-[10px] text-slate-400">Cota Máxima Andina</span>
                    </div>

                    <div class="p-3 rounded-xl bg-slate-950/80 border border-slate-800 flex flex-col justify-between">
                        <span class="text-slate-400 text-[10px] uppercase flex items-center gap-1.5">
                            <i class="fa-solid fa-compress-arrows-alt text-cyan-400"></i> Presión Máx.
                        </span>
                        <div class="text-base sm:text-lg font-bold text-white mt-1">
                            <span id="telemetry-max-pres">1,450</span> <span class="text-[10px] text-cyan-400 font-normal">PSI</span>
                        </div>
                        <span class="text-[10px] text-slate-400">Papallacta Descarga</span>
                    </div>

                    <div class="p-3 rounded-xl bg-slate-950/80 border border-slate-800 flex flex-col justify-between">
                        <span class="text-slate-400 text-[10px] uppercase flex items-center gap-1.5">
                            <i class="fa-solid fa-shield-halved text-emerald-400"></i> Integridad LDS
                        </span>
                        <div class="text-base sm:text-lg font-bold text-emerald-400 mt-1 flex items-center gap-1.5">
                            <span class="w-2 h-2 rounded-full bg-emerald-400"></span> 100% OK
                        </div>
                        <span class="text-[10px] text-slate-400">Sin Desbalances</span>
                    </div>

                    <div class="p-3 rounded-xl bg-slate-950/80 border border-slate-800 flex flex-col justify-between">
                        <span class="text-slate-400 text-[10px] uppercase flex items-center gap-1.5">
                            <i class="fa-solid fa-robot text-purple-400"></i> PIG Inteligente
                        </span>
                        <div id="pig-status-pill" class="text-xs sm:text-sm font-bold text-slate-300 mt-1">
                            EN ESPERA (KM 0)
                        </div>
                        <span id="pig-km-pill" class="text-[10px] text-cyan-400">KM 0.0 / 503.0</span>
                    </div>
                </div>

                <!-- Botonera de Control SCADA Interactiva -->
                <div class="flex flex-wrap items-center justify-between gap-3 p-3 rounded-xl bg-slate-900/80 border border-cyan-500/20 text-xs font-mono">
                    <div class="flex flex-wrap items-center gap-2">
                        <button id="btn-flow-toggle" type="button" onclick="pipelineToggleFlow()" class="px-3.5 py-2 rounded-lg bg-cyan-500 hover:bg-cyan-400 text-slate-950 font-bold flex items-center gap-1.5 transition-all shadow-[0_0_12px_rgba(0,242,254,0.4)]">
                            <i id="btn-flow-icon" class="fa-solid fa-pause"></i> <span id="btn-flow-text">Pausar Flujo</span>
                        </button>
                        
                        <button id="btn-launch-pig" type="button" onclick="pipelineLaunchPIG()" class="px-3.5 py-2 rounded-lg bg-purple-600 hover:bg-purple-500 text-white font-semibold flex items-center gap-1.5 transition-all shadow-[0_0_12px_rgba(139,92,246,0.3)]">
                            <i class="fa-solid fa-rocket text-purple-300"></i> <span>Lanzar PIG Inteligente (503 km)</span>
                        </button>

                        <button id="btn-simulate-surge" type="button" onclick="pipelineSimulateSurge()" class="px-3 py-2 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 border border-amber-500/40 font-semibold flex items-center gap-1.5 transition-all">
                            <i class="fa-solid fa-bolt-lightning text-amber-400"></i> <span>Simular Transitorio / Surge</span>
                        </button>

                        <button id="btn-emergency-stop" type="button" onclick="pipelineEmergencyStop()" class="px-3 py-2 rounded-lg bg-red-950/60 hover:bg-red-900/80 text-red-400 border border-red-500/40 font-semibold flex items-center gap-1.5 transition-all">
                            <i class="fa-solid fa-triangle-exclamation text-red-400"></i> <span>Parada ESD SOTE</span>
                        </button>
                    </div>

                    <!-- Control de Caudal y Velocidad -->
                    <div class="flex items-center gap-3 w-full sm:w-auto justify-end">
                        <label for="pipeline-speed-slider" class="text-slate-400 text-[11px] whitespace-nowrap">Caudal:</label>
                        <input id="pipeline-speed-slider" type="range" min="200" max="400" value="350" step="5" oninput="pipelineUpdateFlowRate(this.value)" class="w-28 sm:w-36 accent-cyan-400 cursor-pointer">
                        <span id="slider-val-readout" class="text-cyan-300 font-bold min-w-[65px] text-right">350k BPD</span>
                    </div>
                </div>

                <!-- Selector Rápido de Estaciones (Pestañas de 11 Instalaciones SOTE) -->
                <div class="flex items-center gap-1.5 overflow-x-auto pb-1 text-[11px] font-mono scrollbar-thin">
                    <span class="text-slate-500 text-[10px] uppercase mr-1 whitespace-nowrap">ESTACIONES SOTE:</span>
                    <button type="button" onclick="pipelineSelectStation(1)" class="st-btn active px-2.5 py-1 rounded bg-cyan-500 text-slate-950 font-bold whitespace-nowrap">01. Lago Agrio</button>
                    <button type="button" onclick="pipelineSelectStation(2)" class="st-btn px-2.5 py-1 rounded bg-slate-900 text-slate-300 hover:text-cyan-300 border border-slate-800 whitespace-nowrap">02. Lumbaqui</button>
                    <button type="button" onclick="pipelineSelectStation(3)" class="st-btn px-2.5 py-1 rounded bg-slate-900 text-slate-300 hover:text-cyan-300 border border-slate-800 whitespace-nowrap">03. El Salado</button>
                    <button type="button" onclick="pipelineSelectStation(4)" class="st-btn px-2.5 py-1 rounded bg-slate-900 text-slate-300 hover:text-cyan-300 border border-slate-800 whitespace-nowrap">04. Baeza</button>
                    <button type="button" onclick="pipelineSelectStation(5)" class="st-btn px-2.5 py-1 rounded bg-slate-900 text-amber-300 hover:text-amber-200 border border-amber-500/30 whitespace-nowrap">05. Papallacta</button>
                    <button type="button" onclick="pipelineSelectStation(6)" class="st-btn px-2.5 py-1 rounded bg-slate-900 text-orange-400 hover:text-orange-300 border border-orange-500/30 whitespace-nowrap">06. San Juan (R)</button>
                    <button type="button" onclick="pipelineSelectStation(7)" class="st-btn px-2.5 py-1 rounded bg-slate-900 text-orange-400 hover:text-orange-300 border border-orange-500/30 whitespace-nowrap">07. Chiriboga (R)</button>
                    <button type="button" onclick="pipelineSelectStation(8)" class="st-btn px-2.5 py-1 rounded bg-slate-900 text-orange-400 hover:text-orange-300 border border-orange-500/30 whitespace-nowrap">08. La Palma (R)</button>
                    <button type="button" onclick="pipelineSelectStation(9)" class="st-btn px-2.5 py-1 rounded bg-slate-900 text-orange-400 hover:text-orange-300 border border-orange-500/30 whitespace-nowrap">09. Sto. Domingo (R)</button>
                    <button type="button" onclick="pipelineSelectStation(10)" class="st-btn px-2.5 py-1 rounded bg-slate-900 text-slate-300 hover:text-cyan-300 border border-slate-800 whitespace-nowrap">10. Quinindé</button>
                    <button type="button" onclick="pipelineSelectStation(11)" class="st-btn px-2.5 py-1 rounded bg-slate-900 text-emerald-400 hover:text-emerald-300 border border-emerald-500/30 whitespace-nowrap">11. Balao</button>
                </div>

                <!-- Canvas Gráfico Principal del Oleoducto SOTE (SVG Panorámico Interactivo) -->
                <div class="relative w-full rounded-xl bg-slate-950/95 border border-cyan-500/30 p-2 sm:p-4 overflow-hidden">
                    
                    <!-- Notificación Flotante de Eventos / PIG / Alertas -->
                    <div id="pipeline-alert-box" class="absolute top-4 left-1/2 -translate-x-1/2 z-30 hidden px-4 py-2 rounded-lg text-xs font-mono border backdrop-blur-md shadow-2xl transition-all duration-300">
                        <span id="pipeline-alert-msg">Mensaje de alerta</span>
                    </div>

                    <!-- HUD Reticles Industriales -->
                    <div class="absolute inset-0 pointer-events-none opacity-20">
                        <div class="absolute top-3 left-3 w-4 h-4 border-t border-l border-cyan-400"></div>
                        <div class="absolute top-3 right-3 w-4 h-4 border-t border-r border-cyan-400"></div>
                        <div class="absolute bottom-3 left-3 w-4 h-4 border-b border-l border-cyan-400"></div>
                        <div class="absolute bottom-3 right-3 w-4 h-4 border-b border-r border-cyan-400"></div>
                    </div>

                    <!-- SVG Principal del Oleoducto SOTE: 1400 x 500 -->
                    <svg id="pipeline-svg" class="w-full h-auto select-none" viewBox="0 0 1400 500" preserveAspectRatio="xMidYMid meet">
                        <defs>
                            <!-- Gradiente de Terreno Andino Ecuatoriano -->
                            <linearGradient id="terrain-grad-sote" x1="0%" y1="0%" x2="0%" y2="100%">
                                <stop offset="0%" stop-color="#111827" stop-opacity="0.95"/>
                                <stop offset="40%" stop-color="#0b111e" stop-opacity="0.98"/>
                                <stop offset="100%" stop-color="#030712" stop-opacity="1"/>
                            </linearGradient>

                            <!-- Gradiente de Presión Hidráulica a lo largo de los 503 km -->
                            <linearGradient id="sote-fluid-grad" x1="0%" y1="0%" x2="100%" y2="0%">
                                <stop offset="0%" stop-color="#00f2fe"/>
                                <stop offset="15%" stop-color="#38bdf8"/>
                                <stop offset="30%" stop-color="#f59e0b"/>
                                <stop offset="45%" stop-color="#fbbf24"/>
                                <stop offset="50%" stop-color="#ef4444"/>
                                <stop offset="65%" stop-color="#f97316"/>
                                <stop offset="85%" stop-color="#00f2fe"/>
                                <stop offset="100%" stop-color="#10b981"/>
                            </linearGradient>

                            <filter id="neon-glow-filter" x="-20%" y="-20%" width="140%" height="140%">
                                <feGaussianBlur stdDeviation="3" result="blur"/>
                                <feComposite in="SourceGraphic" in2="blur" operator="over"/>
                            </filter>
                            
                            <filter id="pig-glow" x="-30%" y="-30%" width="160%" height="160%">
                                <feGaussianBlur stdDeviation="4" result="blur"/>
                                <feComposite in="SourceGraphic" in2="blur" operator="over"/>
                            </filter>
                        </defs>

                        <!-- Capa 1: Fondo Topográfico Real del SOTE (Amazonía, Cruce de Andes y Costa) -->
                        <g id="terrain-layer">
                            <!-- Silueta Geodésica de la Cordillera de los Andes Ecuatorianos -->
                            <path d="M 0 370 L 80 365 L 240 345 L 400 295 L 525 255 L 625 180 L 665 125 L 735 195 L 845 260 L 945 310 L 1055 350 L 1175 370 L 1320 375 L 1400 375 L 1400 500 L 0 500 Z" fill="url(#terrain-grad-sote)" stroke="#1e293b" stroke-width="1.5"/>
                            
                            <!-- Hito de Altitud Máxima: Páramo de Guamaní (4,064 msnm) -->
                            <line x1="665" y1="125" x2="665" y2="70" stroke="#f59e0b" stroke-width="1" stroke-dasharray="3 3"/>
                            <circle cx="665" cy="70" r="3" fill="#f59e0b" filter="url(#neon-glow-filter)"/>
                            <text x="665" y="60" text-anchor="middle" fill="#fbbf24" font-family="Orbitron" font-size="10" font-weight="bold">PASO DE GUAMANÍ &bull; 4,064 msnm</text>
                            <text x="665" y="48" text-anchor="middle" fill="#94a3b8" font-family="JetBrains Mono" font-size="8">CUMBRE ANDINA SOTE // PK 235+000</text>

                            <!-- Líneas de Referencia de Altitud -->
                            <line x1="30" y1="180" x2="1370" y2="180" stroke="#334155" stroke-width="0.8" stroke-dasharray="2 4" opacity="0.3"/>
                            <text x="35" y="175" fill="#64748b" font-family="JetBrains Mono" font-size="8">PÁRAMO / PAPALLACTA // 3,150 msnm</text>

                            <line x1="30" y1="295" x2="1370" y2="295" stroke="#334155" stroke-width="0.8" stroke-dasharray="2 4" opacity="0.3"/>
                            <text x="35" y="290" fill="#64748b" font-family="JetBrains Mono" font-size="8">VALLES INTERANDINOS // 1,300 msnm</text>

                            <line x1="30" y1="365" x2="1370" y2="365" stroke="#334155" stroke-width="0.8" stroke-dasharray="2 4" opacity="0.3"/>
                            <text x="35" y="360" fill="#64748b" font-family="JetBrains Mono" font-size="8">TIERRAS BAJAS / COSTA // 300 - 15 msnm</text>
                        </g>

                        <!-- Capa 2: Tubería del SOTE (Acero API 5L X-60 // 26" y 20") -->
                        <g id="pipeline-conduit-layer">
                            <!-- Tubo Exterior Acero -->
                            <path id="pipeline-backbone" d="M 40,350 C 46.7,350.0 46.7,353.3 80.0,350.0 C 113.3,346.7 186.7,342.5 240.0,330.0 C 293.3,317.5 352.5,290.8 400.0,275.0 C 447.5,259.2 487.5,254.2 525.0,235.0 C 562.5,215.8 601.7,180.8 625.0,160.0 C 648.3,139.2 646.7,107.5 665.0,110.0 C 683.3,112.5 705.0,153.3 735.0,175.0 C 765.0,196.7 810.0,220.8 845.0,240.0 C 880.0,259.2 910.0,275.0 945.0,290.0 C 980.0,305.0 1016.7,319.2 1055.0,330.0 C 1093.3,340.8 1130.8,350.0 1175.0,355.0 C 1219.2,360.0 1289.2,359.2 1320.0,360.0 C 1350.8,360.8 1353.3,360.0 1360.0,360.0" fill="none" stroke="#0f172a" stroke-width="16" stroke-linecap="round" stroke-linejoin="round"/>
                            
